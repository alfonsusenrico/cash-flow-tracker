SESSION_SECRET=replace-with-openssl-rand-hex-32
COOKIE_SECURE=false
APP_ORIGINS=http://localhost:8091
TRUSTED_PROXY_CIDRS=172.16.0.0/12,127.0.0.1/32,::1/128
POSTGRES_DB=ledger
POSTGRES_USER=ledger
POSTGRES_PASSWORD=replace-with-random-db-password
INVITE_CODE=replace-with-random-invite-code

# Optional tuning
TZ=Asia/Jakarta
SUMMARY_CACHE_TTL=30
MONTH_SUMMARY_TTL=60
LOGIN_RATE_LIMIT=10
LOGIN_RATE_WINDOW=300
LOGIN_USER_RATE_LIMIT=5
REGISTER_RATE_LIMIT=5
REGISTER_RATE_WINDOW=900
PASSWORD_MIN_LEN=8
DB_POOL_MIN=1
DB_POOL_MAX=10
DB_POOL_TIMEOUT=30
DB_POOL_MAX_WAITING=100
PUBLIC_RATE_LIMIT=120
PUBLIC_RATE_WINDOW=60
REDIS_URL=redis://redis:6379/0
REDIS_PREFIX=cashflow
RECEIPTS_DIR=/app/storage/receipts
RECEIPT_MAX_MB=10
RECEIPT_WEBP_QUALITY=75
RECEIPT_MAX_PIXELS=50000000
LEDGER_EXPORT_MAX_ROWS=5000

# Telegram Bot (optional - only if using telegram-bot service)
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_URL=https://telegram-webhook.alfonsusenrico.cloud
TELEGRAM_WEBHOOK_SECRET=
WEBHOOK_LISTEN=0.0.0.0
WEBHOOK_PORT=8081
# OpenRouter or DeepSeek API
DEEPSEEK_API_KEY=
# For OpenRouter: https://openrouter.ai/api/v1
# For DeepSeek direct: https://api.deepseek.com
DEEPSEEK_BASE_URL=https://openrouter.ai/api/v1
# For OpenRouter: deepseek/deepseek-chat
# For DeepSeek direct: deepseek-chat
DEEPSEEK_MODEL=deepseek/deepseek-chat
FINANCE_API_BASE_URL=http://api:8000/api
BOT_SECRET=
CONFIDENCE_THRESHOLD=0.75
