SESSION_SECRET=replace-with-openssl-rand-hex-32
# Local HTTP opt-in only. App/base Compose default to true; production rejects false.
COOKIE_SECURE=false
# Local example; production defaults to production and requires secure cookies.
APP_ENV=development
APP_ORIGINS=http://localhost:8090
TRUSTED_PROXY_CIDRS=172.16.0.0/12,127.0.0.1/32,::1/128
POSTGRES_DB=ledger
POSTGRES_USER=ledger
POSTGRES_PASSWORD=replace-with-random-db-password
INVITE_CODE=replace-with-random-invite-code

# Optional tuning
TZ=Asia/Jakarta
SUMMARY_CACHE_TTL=30
MONTH_SUMMARY_TTL=60
LOGIN_RATE_LIMIT=10
LOGIN_RATE_WINDOW=300
LOGIN_USER_RATE_LIMIT=5
REGISTER_RATE_LIMIT=5
REGISTER_RATE_WINDOW=900
PASSWORD_MIN_LEN=8
DB_POOL_MIN=1
DB_POOL_MAX=10
DB_POOL_TIMEOUT=30
DB_POOL_MAX_WAITING=100
PUBLIC_RATE_LIMIT=120
PUBLIC_RATE_WINDOW=60
REDIS_URL=redis://redis:6379/0
REDIS_PREFIX=cashflow
RECEIPTS_DIR=/app/storage/receipts
RECEIPT_MAX_MB=10
RECEIPT_WEBP_QUALITY=75
RECEIPT_MAX_PIXELS=50000000
LEDGER_EXPORT_MAX_ROWS=5000
# Link a due plan to its one certain recorded payment automatically; false is a kill switch
PLAN_AUTO_LINK_ENABLED=true

# Optional backend notification interpretation (disabled until synthetic evaluation passes).
# OpenAI API inputs are not used for training by default. Standard abuse-monitoring
# retention can be up to 30 days unless the configured project has approved controls.
NOTIFICATION_AI_ENABLED=false
NOTIFICATION_AI_MODEL=gpt-5.6-luna
NOTIFICATION_AI_REASONING_EFFORT=low
NOTIFICATION_AI_HISTORY_LIMIT=20
NOTIFICATION_AI_TIMEOUT=30
# Maximum seconds between two notification legs that may be paired into one movement (30-86400)
NOTIFICATION_PAIRING_WINDOW_SECONDS=900
# Lowest AI mapping confidence (0.5-1.0) recorded without owner confirmation
NOTIFICATION_MAPPING_AUTO_THRESHOLD=0.85
# Lowest AI classification confidence (0.5-1.0) recorded without a review flag
NOTIFICATION_REVIEW_CONFIDENCE_THRESHOLD=0.8
# Known transfer fees (IDR, comma-separated) an outbound leg may exceed its inbound leg by; each <= the maximum
MOVEMENT_TRANSFER_FEES=2500,6500,1000,2900
# Largest fee difference ever tolerated when pairing movement legs (0-100000)
MOVEMENT_FEE_MAX_DIFFERENCE=10000
# Deferred re-pairing: run interval (60-86400 s), legs recorded within the lookback (1-168 h),
# and the largest time gap between two strongly evidenced legs (900-172800 s)
MOVEMENT_REPAIR_INTERVAL_SECONDS=600
MOVEMENT_REPAIR_LOOKBACK_HOURS=48
MOVEMENT_REPAIR_MAX_GAP_SECONDS=21600
# History suggestions: rows per owner-started run (1-2000) and rows per model call (1-50)
HISTORY_SUGGESTION_MAX_ROWS=300
HISTORY_SUGGESTION_BATCH_SIZE=20
# Lowest model confidence (0.5-1.0) that records a typed capture without asking for the category
CAPTURE_CONFIDENCE_THRESHOLD=0.8
# Server named in device-pairing QR codes (https origin only); the companion refuses any other server
PAIRING_SERVER_URL=https://finance.alfonsusenrico.com
# Development-only, no-write owner dry-run. Keep false in every other environment.
NOTIFICATION_AI_DRY_RUN_ENABLED=false
OPENAI_API_KEY=

# Timeout in seconds for LLM API calls (increase if free models are timing out)
# The model used for extracting text from images
