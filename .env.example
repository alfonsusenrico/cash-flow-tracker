SESSION_SECRET=replace-with-openssl-rand-hex-32
COOKIE_SECURE=false
APP_ORIGINS=http://localhost:8090
TRUSTED_PROXY_CIDRS=172.16.0.0/12,127.0.0.1/32,::1/128
POSTGRES_DB=ledger
POSTGRES_USER=ledger
POSTGRES_PASSWORD=replace-with-random-db-password
INVITE_CODE=replace-with-random-invite-code

# Optional tuning
TZ=Asia/Jakarta
SUMMARY_CACHE_TTL=30
MONTH_SUMMARY_TTL=60
LOGIN_RATE_LIMIT=10
LOGIN_RATE_WINDOW=300
LOGIN_USER_RATE_LIMIT=5
REGISTER_RATE_LIMIT=5
REGISTER_RATE_WINDOW=900
PASSWORD_MIN_LEN=8
DB_POOL_MIN=1
DB_POOL_MAX=10
DB_POOL_TIMEOUT=30
DB_POOL_MAX_WAITING=100
PUBLIC_RATE_LIMIT=120
PUBLIC_RATE_WINDOW=60
REDIS_URL=redis://redis:6379/0
REDIS_PREFIX=cashflow
RECEIPTS_DIR=/app/storage/receipts
RECEIPT_MAX_MB=10
RECEIPT_WEBP_QUALITY=75
RECEIPT_MAX_PIXELS=50000000
LEDGER_EXPORT_MAX_ROWS=5000

# Optional backend notification interpretation (disabled until synthetic evaluation passes).
# OpenAI API inputs are not used for training by default. Standard abuse-monitoring
# retention can be up to 30 days unless the configured project has approved controls.
NOTIFICATION_AI_ENABLED=false
NOTIFICATION_AI_MODEL=gpt-5.6-luna
NOTIFICATION_AI_REASONING_EFFORT=low
NOTIFICATION_AI_HISTORY_LIMIT=20
NOTIFICATION_AI_TIMEOUT=30
# Maximum seconds between two notification legs that may be paired into one movement (30-86400)
NOTIFICATION_PAIRING_WINDOW_SECONDS=900
# Lowest AI mapping confidence (0.5-1.0) recorded without owner confirmation
NOTIFICATION_MAPPING_AUTO_THRESHOLD=0.85
# Development-only, no-write owner dry-run. Keep false in every other environment.
APP_ENV=production
NOTIFICATION_AI_DRY_RUN_ENABLED=false
OPENAI_API_KEY=

# Telegram Bot (optional - only if using telegram-bot service)
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_URL=https://telegram-webhook.alfonsusenrico.com/cash-flow-tracker
TELEGRAM_WEBHOOK_SECRET=
WEBHOOK_LISTEN=0.0.0.0
WEBHOOK_PORT=8081
# OpenRouter or DeepSeek API
DEEPSEEK_API_KEY=
# For OpenRouter: https://openrouter.ai/api/v1
# For DeepSeek direct: https://api.deepseek.com
DEEPSEEK_BASE_URL=https://openrouter.ai/api/v1
# For OpenRouter: deepseek/deepseek-chat
# For DeepSeek direct: deepseek-chat
DEEPSEEK_MODEL=deepseek/deepseek-chat
FINANCE_API_BASE_URL=http://api:8000
BOT_SECRET=
CONFIDENCE_THRESHOLD=0.75
# Whether to use a two-step vision extraction architecture (vision model extracts text, text model calls tools)
USE_TWO_STEP_VISION=true
# Timeout in seconds for LLM API calls (increase if free models are timing out)
LLM_TIMEOUT=300
# The base URL used for vision API calls (defaults to OpenRouter if not specified)
VISION_BASE_URL=https://openrouter.ai/api/v1
# The model used for extracting text from images
VISION_MODEL=meta-llama/llama-3.2-11b-vision-instruct:free
