   "390-dark"
  ],
  "steps": [
   {
    "eval": "fetch('/api/ingest/test-sessions/current',{credentials:'include'}).then((r)=>r.json()).then((d)=> d.session && d.session.status==='open' ? 'open' : fetch('/api/ingest/test-sessions',{method:'POST',credentials:'include',headers:{'Content-Type':'application/json'},body:JSON.stringify({duration_minutes:60})}).then((r)=>r.status)).then((s)=>{ location.reload(); return String(s); })",
    "after": 3500
   }
  ],
  "cleanup": "fetch('/api/ingest/test-sessions/current',{credentials:'include'}).then((r)=>r.json()).then((d)=> d.session && d.session.status==='open' ? fetch('/api/ingest/test-sessions/'+d.session.id+'/end',{method:'POST',credentials:'include'}).then((r)=>'ended '+r.status) : 'none')"
