# Telegram
TELEGRAM_BOT_TOKEN=
# Public HTTPS URL Telegram will POST updates to, e.g. https://bot.example.com/telegram/webhook
TELEGRAM_WEBHOOK_URL=
# Shared secret validated via the X-Telegram-Bot-Api-Secret-Token header
TELEGRAM_WEBHOOK_SECRET=
# Local bind for the webhook server (behind nginx)
WEBHOOK_LISTEN=0.0.0.0
WEBHOOK_PORT=8081

# DeepSeek (OpenAI-compatible) - can use OpenRouter or direct DeepSeek API
DEEPSEEK_API_KEY=
# For OpenRouter: https://openrouter.ai/api/v1
# For DeepSeek direct: https://api.deepseek.com
DEEPSEEK_BASE_URL=https://openrouter.ai/api/v1
# For OpenRouter: deepseek/deepseek-chat
# For DeepSeek direct: deepseek-chat
DEEPSEEK_MODEL=deepseek/deepseek-chat

# Finance app public API base (no trailing slash), e.g. https://finance.example.com/api
FINANCE_API_BASE_URL=

# Postgres for the bot's own state (users + pending actions)
BOT_DATABASE_URL=postgresql://ledger:ledgerpass@db:5432/ledger

# Fernet key (44-char urlsafe base64) for encrypting stored API keys at rest.
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
BOT_SECRET=

# Auto-execute create only when model confidence >= this (0..1). Updates/deletes always confirm.
CONFIDENCE_THRESHOLD=0.75
